# =====================================================
# Configurations
# =====================================================

font-size = 16
mouse-hide-while-typing = true
background-opacity = 1
window-padding-x = 10
window-padding-y = 10
window-height = 40
window-width = 160
window-decoration = none
background-blur-radius = 20
confirm-close-surface = false

# =====================================================
# Keybinds
# =====================================================

keybind = ctrl+right=text:\x1bf
keybind = ctrl+left=text:\x1bb
keybind = delete=text:\x04
keybind = cmd+t=unbind
keybind = ctrl+backspace=text:\x17
keybind = ctrl+delete=text:\x1bd
keybind = global:f4=toggle_quick_terminal

# =====================================================
# Quick Terminal Toggle
# =====================================================

#quick-terminal-size = 40%,70%
#quick-terminal-position = center
#quick-terminal-autohide = true

# =====================================================
# MacOs Customizations
# =====================================================

#macos-icon = retro
#macos-icon = custom-style
#macos-icon-frame = aluminum
#macos-icon-ghost-color = #ebebeb
#macos-icon-screen-color = #000000,#000000

# =====================================================
# Monochrome Theme
# =====================================================

palette = 0=#000000
palette = 1=#7a7a7a
palette = 2=#b0b0b0
palette = 3=#8a8a8a
palette = 4=#d0d0d0
palette = 5=#9a9a9a
palette = 6=#c0c0c0
palette = 7=#ffffff
palette = 8=#3a3a3a
palette = 9=#9a9a9a
palette = 10=#d0d0d0
palette = 11=#b0b0b0
palette = 12=#f0f0f0
palette = 13=#cfcfcf
palette = 14=#e0e0e0
palette = 15=#ffffff
